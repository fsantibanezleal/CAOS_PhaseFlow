{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phaseflow.index/v1",
  "title": "PhaseFlow case index",
  "description": "Inventory written by pipeline/core/manifest.py. Cross-file existence and version coherence are checked by check_artifacts.py.",
  "type": "object",
  "required": ["schema", "engine_version", "n_cases", "cases"],
  "properties": {
    "schema": {"const": "phaseflow.index/v1"},
    "engine_version": {"type": "string", "pattern": "^\\d+\\.\\d{2}\\.\\d{3}$"},
    "n_cases": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "category", "manifest_path", "default", "lane", "title", "role"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "manifest_path": {"type": "string", "pattern": "^manifests/[^/]+\\.json$"},
          "default": {"type": "boolean"},
          "lane": {"enum": ["live", "replay"]},
          "title": {"$ref": "#/$defs/bilingual"},
          "role": {"$ref": "#/$defs/bilingual"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "es"],
      "properties": {"en": {"type": "string", "minLength": 1}, "es": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
