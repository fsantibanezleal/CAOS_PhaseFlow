{
  "name": "phaseflow-frontend",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "predev": "node copy-data.mjs",
    "dev": "vite",
    "prebuild": "node copy-data.mjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node spa-404.mjs",
    "preview": "vite preview",
    "test": "node --import tsx --test && node --import tsx scripts/check-arch-bounds.mjs",
    "gate": "node scripts/gate.mjs",
    "check:arch": "node --import tsx scripts/check-arch-bounds.mjs",
    "verify:profile": "node scripts/verify-profile-size.mjs",
    "verify:grade": "node scripts/verify-grade-source.mjs",
    "verify:focus": "node scripts/verify-focus-capacity.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:infeasible": "node scripts/verify-infeasible.mjs",
    "verify:stage": "node scripts/verify-stage.mjs"
  },
  "dependencies": {
    "@fasl-work/caos-app-shell": "0.19.6",
    "katex": "0.19.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.171.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  }
}
