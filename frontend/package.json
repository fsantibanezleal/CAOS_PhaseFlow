{
  "name": "phaseflow-frontend",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-data-entry.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-data-entry.mjs",
    "contracts:types": "node scripts/gen-contract-types.mjs",
    "contracts:check": "node scripts/gen-contract-types.mjs --check",
    "build": "node scripts/gen-contract-types.mjs --check && tsc --noEmit && vite build",
    "postbuild": "node spa-404.mjs && node scripts/materialize-routes.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/codegen-compatibility.test.mjs && node --import tsx --test test/contract.test.ts test/copy-data-product.test.ts test/engine-text.test.ts test/feasibility.test.ts test/gershon.test.ts test/guard.test.ts test/learned-keys.test.ts test/live-guard-eligibility.test.ts test/parity.test.ts test/public-json-cache.test.ts test/showcase-adversarial.test.ts test/surrogate-parity.test.ts test/tokens.test.ts && vitest run src/lib/copy-data.test.ts && node --import tsx scripts/check-arch-bounds.mjs && node scripts/check-method-language.mjs",
    "check:method-language": "node scripts/check-method-language.mjs",
    "gate": "node scripts/check_story_mode.mjs && node scripts/gate.mjs",
    "check:arch": "node --import tsx scripts/check-arch-bounds.mjs",
    "verify:profile": "node scripts/verify-profile-size.mjs",
    "verify:grade": "node scripts/verify-grade-source.mjs",
    "verify:focus": "node scripts/verify-focus-capacity.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:infeasible": "node scripts/verify-infeasible.mjs",
    "verify:stage": "node scripts/verify-stage.mjs",
    "verify:showcase": "node scripts/verify-showcase.mjs",
    "check:story": "node scripts/check_story_mode.mjs"
  },
  "dependencies": {
    "@fasl-work/caos-app-shell": "0.25.0",
    "katex": "0.19.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.171.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.171.0",
    "openapi-typescript": "7.13.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@redocly/openapi-core": {
      ".": "1.34.22",
      "minimatch": "11.0.1"
    }
  }
}
